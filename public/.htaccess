Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# One canonical address: https://joinindigo.app
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://joinindigo.app%{REQUEST_URI} [L,R=301]

# Next writes the generated share image without a file extension
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
